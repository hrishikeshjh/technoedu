# ==============================================================================
# TechnoEdu Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` and supply your own values.
# NEVER commit `.env` or `.env.local` with real secrets to version control.
# Variables prefixed with `VITE_` are exposed to the browser bundle.
# All other variables are server-side only and MUST NEVER use the `VITE_` prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application (Public & Server)
# ------------------------------------------------------------------------------
# Public application URL used for password reset & verification links
VITE_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Optional custom API base URL (leave blank for same-origin /api)
VITE_API_BASE_URL=
# Node environment: development | production
NODE_ENV=development
# HTTP server port for `npm start` / `vite`
PORT=3000

# ------------------------------------------------------------------------------
# 2. Authentication Provider & Sessions
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (Google Cloud Console -> APIs & Services -> Credentials)
# Public client ID (safe for browser):
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Server-side Google Client ID used to verify ID token audience (private/server):
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Server-side session signing secret (REQUIRED in production, 64-char random hex)
AUTH_SESSION_SECRET=replace_with_a_64_char_random_hex_secret

# ------------------------------------------------------------------------------
# 3. Database
# ------------------------------------------------------------------------------
# Local SQLite database file is stored at `data/technoedu.db` (or `/tmp/technoedu.db` on Vercel)
# DATABASE_URL=file:./data/technoedu.db

# ------------------------------------------------------------------------------
# 4. Email / OTP Provider (Resend-compatible REST API)
# ------------------------------------------------------------------------------
# Server-side API key for sending email verification codes & password reset links
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key_here
# Verified sender email address (e.g., TechnoEdu <no-reply@yourdomain.com>)
EMAIL_FROM=your_verified_sender_email@example.com

# ------------------------------------------------------------------------------
# 5. Storage (Cloudflare R2 Educational CDN)
# ------------------------------------------------------------------------------
# Server-side R2 credentials (NEVER expose via VITE_)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=technoedu-blogs

# Public CDN URLs (safe for browser)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
VITE_R2_BLOGS_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
